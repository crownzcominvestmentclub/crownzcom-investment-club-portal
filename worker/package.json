{
  "name": "crownzcom-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create crownzcom",
    "db:migrate:local": "wrangler d1 migrations apply crownzcom --local",
    "db:migrate:remote": "wrangler d1 migrations apply crownzcom --remote",
    "db:seed:local": "wrangler d1 execute crownzcom --local --file=./migrations/0002_seed.sql",
    "db:seed:remote": "wrangler d1 execute crownzcom --remote --file=./migrations/0002_seed.sql",
    "db:backfill-loans:local": "wrangler d1 execute crownzcom --local --file=./scripts/backfill-loan-schedule-metadata.sql",
    "db:backfill-loans:remote": "wrangler d1 execute crownzcom --remote --file=./scripts/backfill-loan-schedule-metadata.sql",
    "secret:jwt": "wrangler secret put JWT_SECRET",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250115.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.95.0"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "zod": "^3.23.8"
  }
}
